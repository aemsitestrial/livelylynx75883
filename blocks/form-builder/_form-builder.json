{
  "definitions": [
    {
      "title": "Form Builder",
      "id": "form-builder",
      "plugins": {
        "xwalk": {
          "page": {
            "resourceType": "core/franklin/components/block/v1/block",
            "template": {
              "name": "Form Builder",
              "model": "form-builder",
              "filter": "form-builder"
            }
          }
        }
      }
    },
    {
      "title": "Form Field",
      "id": "form-field",
      "plugins": {
        "xwalk": {
          "page": {
            "resourceType": "core/franklin/components/block/v1/block/item",
            "template": {
              "name": "Form Field",
              "model": "form-field"
            }
          }
        }
      }
    }
  ],
  "models": [
    {
      "id": "form-builder",
      "fields": [
        {
          "component": "text",
          "valueType": "string",
          "name": "title",
          "label": "Form Title"
        },
        {
          "component": "richtext",
          "valueType": "string",
          "name": "description",
          "value": "",
          "label": "Description"
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "buttonLabel",
          "label": "Submit Button Label"
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "actionUrl",
          "label": "Form Action URL (where submissions are sent)"
        }
      ]
    },
    {
      "id": "form-field",
      "fields": [
        {
          "component": "text",
          "valueType": "string",
          "name": "label",
          "label": "Field label",
          "required": true
        },
        {
          "component": "select",
          "valueType": "string",
          "name": "type",
          "label": "Field type",
          "value": "text",
          "options": [
            { "name": "Text", "value": "text" },
            { "name": "Email", "value": "email" },
            { "name": "Phone", "value": "tel" },
            { "name": "Number", "value": "number" },
            { "name": "Date", "value": "date" },
            { "name": "Textarea", "value": "textarea" },
            { "name": "Dropdown (select)", "value": "select" },
            { "name": "Radio buttons", "value": "radio" },
            { "name": "Checkbox", "value": "checkbox" }
          ]
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "options",
          "label": "Options / default value - comma-separated list for Dropdown & Radio (mark the default by starting it with *); for other field types just enter the default value here"
        },
        {
          "component": "boolean",
          "valueType": "boolean",
          "name": "required",
          "label": "Required field"
        }
      ]
    }
  ],
  "filters": [
    {
      "id": "form-builder",
      "components": [
        "form-field"
      ]
    }
  ]
